# Copia questo file in ".env" (nella stessa cartella deploy/) e modifica se necessario.
# ".env" è già ignorato da git (vedi .gitignore alla radice del progetto) quindi va bene
# scriverci sopra valori specifici della VM.

# Porta su cui è raggiungibile il server di signaling WebSocket (ws://<host>:PORT).
SIGNALING_PORT=8080

# Porta su cui è raggiungibile la webapp (http://<host>:PORT). Diversa da 443/4443 usate
# dal deployment del relay MoQ, così i due stack possono girare insieme sulla stessa VM.
FRONTEND_PORT=8081

# Le credenziali del server TURN NON sono qui: sono in ../turn/turnserver.conf
# (riga "user=spaceinvasion:CHANGE_ME_PASSWORD") perché coturn le legge da quel file di
# configurazione, non da variabili d'ambiente. Ricordati di cambiarle lì prima di esporre
# il server, vedi DEPLOY.md punto 2.
